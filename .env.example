# Supabase project for the registry. When these are unset, the app serves
# the in-memory demonstration dataset instead, so local dev works with no
# database at all.

# Project URL, from Supabase dashboard: Settings, API.
SUPABASE_URL=

# Publishable key (sb_publishable_...). Read-only registry access.
SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_...). Server-side only: used by the seed script
# and the /registry intake form. Never exposed to the browser.
SUPABASE_SECRET_KEY=
